{% from 'macros/policy_macros.lua.j2' import policy_get_tagset %}
{% from 'macros/common_macros.lua.j2' import string_table %}

{% set tf = cfg.tunnel_filter -%}
{% set rpz = tf.rpz_builder -%}
{% if tf.enable -%}
modules.load('dns_tunnel_filter')
ffi.cdef([[
int dns_tunnel_filter_setup(const char *nn_file, const char *mmap_file, kr_rule_tags_t tags, uint8_t sensitivity, uint8_t threshold,
		size_t capacity, uint32_t instant_limit, uint32_t rate_limit);
int dns_tunnel_rpz_builder_setup(kr_rule_tags_t add_tags, kr_rule_tags_t rpz_tags, uint16_t hit_threshold, uint16_t hit_time_window_ms);
int dns_tunnel_filter_refresh_tags(kr_rule_tags_t tags, kr_rule_tags_t add_tags, kr_rule_tags_t rpz_tags);
]])

local filter_tag_names  = {{ string_table(tf.tags) }}
local rpz_add_tag_names = {{ string_table(rpz.add_tags) }}
local rpz_rpz_tag_names = {{ string_table(rpz.rpz_tags) }}

function dns_tunnel_filter_refresh_tags()
	return C.dns_tunnel_filter_refresh_tags(
		policy.get_tagset(filter_tag_names),
		policy.get_tagset(rpz_add_tag_names),
		policy.get_tagset(rpz_rpz_tag_names))
end

assert(C.dns_tunnel_filter_setup(
	'{{ tf.file }}',
	'dns_tunnel_filter',
	{{ policy_get_tagset(tf.tags) }},
	{{ tf.sensitivity }},
	{{ tf.threshold }},
	2^20, 2^12, 2^17
) == 0);

{% if rpz.enable -%}
assert(C.dns_tunnel_rpz_builder_setup(
	{{ policy_get_tagset(rpz.add_tags) }},
	{{ policy_get_tagset(rpz.rpz_tags) }},
	{{ rpz.threshold }},
	{{ rpz.time_window_ms }}
) == 0);
{%- endif %}
{%- endif %}
